<Project Sdk="Microsoft.Build.Sql/2.2.0">
  <PropertyGroup>
    <Name>ElysiumDatabase.Schema</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <QueryStoreCaptureMode>Auto</QueryStoreCaptureMode>
    <QueryStoreDesiredState>Off</QueryStoreDesiredState>
    <QueryStoreStaleQueryThreshold>30</QueryStoreStaleQueryThreshold>
    <QueryStoreMaxStorageSize>1000</QueryStoreMaxStorageSize>
    <TargetRecoveryTimePeriod>60</TargetRecoveryTimePeriod>
    <PageVerify>CHECKSUM</PageVerify>
    <CompatibilityMode>150</CompatibilityMode>
    <AnsiNullDefault>False</AnsiNullDefault>
    <AnsiNulls>False</AnsiNulls>
    <AnsiPadding>False</AnsiPadding>
    <AnsiWarnings>False</AnsiWarnings>
    <ArithAbort>False</ArithAbort>
    <ConcatNullYieldsNull>False</ConcatNullYieldsNull>
    <QuotedIdentifier>False</QuotedIdentifier>
    <DefaultCursor>GLOBAL</DefaultCursor>
    <AutoClose>True</AutoClose>
    <SuppressTSqlWarnings>71502</SuppressTSqlWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.Master" Version="160.2.8" />
  </ItemGroup>

  <!--
    These definitions were extracted from Elysium_DEV with unresolved or ambiguous
    references. Keep them under source control, but exclude them from the DACPAC
    model until their references are repaired.
  -->
  <ItemGroup>
    <Build Remove="dbo\Functions\getAdditionalSkillRequiredContainer.sql" />
    <Build Remove="dbo\Functions\getAdditionalSkillRequiredGatherable.sql" />
    <Build Remove="dbo\Functions\getLootTableName.sql" />
    <Build Remove="dbo\Functions\getMaxRarityId*.sql" />
    <Build Remove="dbo\Functions\getMinRarityId*.sql" />
    <Build Remove="dbo\Functions\getSkillMinLevelId.sql" />
    <Build Remove="dbo\Functions\getStatExperience.sql" />
    <Build Remove="dbo\Functions\getTypeNameEntity.sql" />
    <Build Remove="dbo\Functions\getWorldObjectClassificationTypeName.sql" />
    <Build Remove="dbo\StoredProcedures\enumCraftingQuestTypes.sql" />
    <Build Remove="dbo\StoredProcedures\RestoreConfigDetailsColumnsDataTables.sql" />
    <Build Remove="dbo\StoredProcedures\SaveConfigDetailsColumnsDataTables.sql" />
    <Build Remove="dbo\StoredProcedures\spDamageTypes_GetList.sql" />
    <Build Remove="dbo\StoredProcedures\spEffectAmountTypes_GetList.sql" />
    <Build Remove="dbo\StoredProcedures\spEffectTypes_GetList.sql" />
    <Build Remove="dbo\StoredProcedures\spEntityStats.sql" />
    <Build Remove="dbo\StoredProcedures\spGlobal_StatsGetList.sql" />
    <Build Remove="dbo\StoredProcedures\spPlayerAccount_Create.sql" />
    <Build Remove="dbo\StoredProcedures\spPlayerAccount_Create2.sql" />
    <Build Remove="dbo\StoredProcedures\spPlayerAccount_ResetPassword.sql" />
    <Build Remove="dbo\StoredProcedures\spPlayerAccount_ReturnPassword.sql" />
    <Build Remove="dbo\StoredProcedures\spQuest_GetTiersRanks.sql" />
    <Build Remove="dbo\StoredProcedures\spQuestTypes_GetList.sql" />
    <Build Remove="Security\Elysium.sql" />

    <None Include="dbo\Functions\getAdditionalSkillRequiredContainer.sql" />
    <None Include="dbo\Functions\getAdditionalSkillRequiredGatherable.sql" />
    <None Include="dbo\Functions\getLootTableName.sql" />
    <None Include="dbo\Functions\getMaxRarityId*.sql" />
    <None Include="dbo\Functions\getMinRarityId*.sql" />
    <None Include="dbo\Functions\getSkillMinLevelId.sql" />
    <None Include="dbo\Functions\getStatExperience.sql" />
    <None Include="dbo\Functions\getTypeNameEntity.sql" />
    <None Include="dbo\Functions\getWorldObjectClassificationTypeName.sql" />
    <None Include="dbo\StoredProcedures\enumCraftingQuestTypes.sql" />
    <None Include="dbo\StoredProcedures\RestoreConfigDetailsColumnsDataTables.sql" />
    <None Include="dbo\StoredProcedures\SaveConfigDetailsColumnsDataTables.sql" />
    <None Include="dbo\StoredProcedures\spDamageTypes_GetList.sql" />
    <None Include="dbo\StoredProcedures\spEffectAmountTypes_GetList.sql" />
    <None Include="dbo\StoredProcedures\spEffectTypes_GetList.sql" />
    <None Include="dbo\StoredProcedures\spEntityStats.sql" />
    <None Include="dbo\StoredProcedures\spGlobal_StatsGetList.sql" />
    <None Include="dbo\StoredProcedures\spPlayerAccount_Create.sql" />
    <None Include="dbo\StoredProcedures\spPlayerAccount_Create2.sql" />
    <None Include="dbo\StoredProcedures\spPlayerAccount_ResetPassword.sql" />
    <None Include="dbo\StoredProcedures\spPlayerAccount_ReturnPassword.sql" />
    <None Include="dbo\StoredProcedures\spQuest_GetTiersRanks.sql" />
    <None Include="dbo\StoredProcedures\spQuestTypes_GetList.sql" />
    <None Include="Security\Elysium.sql" />
  </ItemGroup>

  <ItemGroup>
    <Build Remove="Scripts\Pre-Deployment.sql" />
    <Build Remove="Scripts\Post-Deployment.sql" />
    <Build Remove="Scripts\Migrations\**\*.sql" />
    <None Include="Scripts\Pre-Deployment.sql" />
    <None Include="Scripts\Post-Deployment.sql" />
    <None Include="Scripts\Migrations\**\*.sql" />
    <PreDeploy Include="Scripts\Pre-Deployment.sql" />
    <PostDeploy Include="Scripts\Post-Deployment.sql" />
  </ItemGroup>
</Project>
